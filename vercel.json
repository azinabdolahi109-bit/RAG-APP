{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/main.py"
    },
    {
      "source": "/health",
      "destination": "/backend/main.py"
    },
    {
      "source": "/upload",
      "destination": "/backend/main.py"
    },
    {
      "source": "/ask",
      "destination": "/backend/main.py"
    },
    {
      "source": "/((?!api|health|upload|ask).*)$",
      "destination": "/frontend/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
